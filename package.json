{
  "name": "projects-view",
  "version": "1.0.0",
  "description": "A viewer for local development projects",
  "main": "server.js",
  "bin": {
    "pview": "./server.js",
    "pview-stop": "./stop.js",
    "pview-link": "./link.js",
    "pview-unlink": "./unlink.js"
  },
  "scripts": {
    "start": "node server.js",
    "gen": "node generate-projects.js",
    "view": "open http://localhost:3131",
    "setup": "node setup.js",
    "postinstall": "node setup.js --if-missing",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:screenshot": "UPDATE_README_SCREENSHOT=1 playwright test tests/e2e/home.spec.js --grep \"captures README screenshot\""
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  },
  "author": "Miguel Perez",
  "license": "MIT"
}
